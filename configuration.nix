{ config, pkgs, ... }:

{
  imports = [
    ./hardware-configuration.nix # copied from /etc/nixos, generated by the installer
    ./dev.nix                    # editors, languages, CLI tools
    ./windows-vm.nix             # libvirt/QEMU host for the S32DS Windows VM
    ./bench-lan.nix              # eno1 static IP, dnsmasq DHCP/DNS, chrony for canpi
  ];

  # ---------------------------------------------------------------- boot
  # Match what your installer generated. If it set up GRUB instead of
  # systemd-boot, copy those lines from /etc/nixos/configuration.nix.
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  # ---------------------------------------------------------------- basics
  networking.hostName = "supernode";
  networking.networkmanager.enable = true; # Wi-Fi via GNOME settings

  time.timeZone = "America/Chicago";
  i18n.defaultLocale = "en_US.UTF-8";

  # ---------------------------------------------------------------- desktop
  # GNOME on Wayland (25.11+ option names; X11 session no longer exists)
  services.displayManager.gdm.enable = true;
  services.desktopManager.gnome.enable = true;

  # Audio
  services.pulseaudio.enable = false;
  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    pulse.enable = true;
  };

  # This box is mostly reached over SSH. GNOME/GDM will otherwise suspend
  # it after ~15-20 min idle and drop your sessions.
  systemd.targets.sleep.enable = false;
  systemd.targets.suspend.enable = false;
  systemd.targets.hibernate.enable = false;
  systemd.targets.hybrid-sleep.enable = false;

  # ---------------------------------------------------------------- user
  users.users.supernode = {
    isNormalUser = true;
    description = "Michael";
    extraGroups = [
      "wheel"          # sudo
      "networkmanager"
      "dialout"        # FTDI / USB serial consoles without sudo
    ];

    openssh.authorizedKeys.keys = [
      # TODO: paste your MacBook's public key (cat ~/.ssh/id_ed25519.pub)
      # BEFORE rebuilding. Password login is off below, so without this
      # line SSH will refuse you (the local console still works).
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHkcBGAmJGP2ib43iVrkKxmMaFBh0HSqdwDao+oh0dmC michaelpetersen@Michaels-MacBook-Pro.local"
    ];
  };

  # ---------------------------------------------------------------- ssh
  services.openssh = {
    enable = true; # opens port 22 in the firewall automatically
    settings = {
      PasswordAuthentication = false;
      KbdInteractiveAuthentication = false;
      PermitRootLogin = "no";
    };
  };

  # mDNS so the Mac can reach it as supernode.local on home Wi-Fi
  services.avahi = {
    enable = true;
    nssmdns4 = true;
    publish = {
      enable = true;
      addresses = true;
    };
  };

  # ---------------------------------------------------------------- nix
  nix.settings = {
    experimental-features = [ "nix-command" "flakes" ];
    auto-optimise-store = true; # dedupe identical files in /nix/store
  };
  nixpkgs.config.allowUnfree = true; # VS Code, Chromium codecs, etc.
  # Garbage collection is handled by programs.nh in dev.nix.

  # Set by the installer. Do NOT change it on upgrades; it pins
  # stateful defaults (database formats etc.), not the package versions.
  # Use whatever value your generated configuration.nix had.
  system.stateVersion = "26.05";
}
